{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "scripts",
    "build",
    "e2e",
    "src/core",
    "src/runner",
    "src/types",
    "src/storage/types.ts"
  ],
  "exclude": ["**/*.test.ts", "src/runner/worker/pyodide.worker.ts", "src/runner/browserRunner.ts"]
}
