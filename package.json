{
  "name": "elite-code",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13",
    "npm": ">=11"
  },
  "scripts": {
    "predev": "tsx scripts/pyodide-assets.ts",
    "dev": "vite",
    "prebuild": "tsx scripts/pyodide-assets.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pyodide:assets": "tsx scripts/pyodide-assets.ts",
    "lint": "eslint . && prettier --check . && uv run ruff check harness && uv run ruff format --check harness",
    "lint:fix": "eslint . --fix && prettier --write . && uv run ruff check --fix harness && uv run ruff format harness",
    "typecheck": "tsc -b --noEmit",
    "schema:types": "tsx scripts/gen-types.ts",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:py": "uv run pytest",
    "test:e2e": "playwright test",
    "problem:validate": "tsx scripts/problem-validate.ts",
    "problem:add": "tsx scripts/problem-add.ts",
    "schema:guide": "tsx scripts/sync-guide-examples.ts",
    "schema:check": "tsx scripts/gen-types.ts --check && tsx scripts/sync-guide-examples.ts --check"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "diff": "^9.0.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.66.0",
    "monaco-editor": "^0.57.0",
    "pyodide": "314.0.7",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.16.1",
    "react-router": "^8.5.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "jsdom": "^27.0.1",
    "json-schema-to-typescript": "^16.0.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
